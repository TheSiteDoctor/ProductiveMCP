# Productive.io API Configuration
PRODUCTIVE_API_TOKEN=your_api_token_here
PRODUCTIVE_ORG_ID=your_org_id_here

# Server Configuration
PORT=3000
NODE_ENV=production

# Optional: Default project for tasks (can be overridden per request)
# DEFAULT_PROJECT_ID=1234

# Optional: Current-user resolution for time-tracking tools
#
# The timer / time-entry / list-my-tasks tools need to know "who am I"
# to default `person_id` and `assignee_id`. Lookup order:
#   1. PRODUCTIVE_PERSON_ID below (fastest — find it in your Productive
#      profile URL: app.productive.io/<orgId>/people/<personId>).
#   2. GET /people/me — works on most Productive plans.
#   3. GET /people?filter[email]=PRODUCTIVE_USER_EMAIL — fallback when
#      /people/me is unavailable.
# PRODUCTIVE_PERSON_ID=1234567
# PRODUCTIVE_USER_EMAIL=you@example.com
